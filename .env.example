# Server-side marketplace discovery and optional authenticated sandbox ordering.
MARKETPLACE_API_BASE_URL=https://jugaad-food-marketplace.vercel.app
MARKETPLACE_AGENT_API_KEY=

# Required for persistent checkout on a production deployment. Local dev defaults to SQLite.
JUGAAD_DATABASE_URL=
JUGAAD_DATABASE_CA=
JUGAAD_TRANSACTION_DB_PATH=

# AI and voice settings are private. Configure them in .env.local.
GEMINI_API_KEY=
# Optional override. The default is gemini-3.5-flash-lite.
GEMINI_MODEL=
# Gnani Prisma and Timbre use the same server-side Vachana API key.
GNANI_API_KEY=
# Optional Timbre pacing, 0.85 to 1.15. Defaults to 1.0.
GNANI_TTS_SPEED=
FRAPIDO_BASE_URL=
FRAPIDO_API_KEY=
SUBER_BASE_URL=
SUBER_API_KEY=
